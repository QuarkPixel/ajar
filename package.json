    "release": "node scripts/release.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.32",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  }
}
