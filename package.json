{
  "name": "ajar",
  "private": true,
  "version": "1.1.2",
  "type": "module",
  "description": "Type an intention before entering a site.",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc --noEmit && vite build",
